{
  "name": "rulelock",
  "version": "0.1.0",
  "description": "Compile repository rules into deterministic guardrails for AI coding agents.",
  "type": "module",
  "bin": {
    "rulelock": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "docs"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:acceptance": "npm run build && node scripts/acceptance.mjs",
    "demo": "npm run build && node scripts/demo.mjs"
  },
  "keywords": [
    "ai",
    "coding-agents",
    "guardrails",
    "git-hooks",
    "policy",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bradleyharner97-cmd/rulelock.git"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "picomatch": "^4.0.3",
    "yaml": "^2.8.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/picomatch": "^4.0.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
